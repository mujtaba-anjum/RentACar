@model List<Car>
@{
    ViewData["Title"] = "Available Cars";
}

<h2>Available Cars</h2>
<p class="text-muted">Select a car and click "Book Car".</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No cars are available right now.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var car in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title">@car.Name</h5>
                        <p class="card-text">PKR @car.PricePerDay.ToString("N0") / day</p>
                        <div class="mb-3">
                            <span class="badge bg-success">Available</span>
                        </div>

                        <form asp-controller="Cars" asp-action="Book" method="post" class="mt-auto">
                            <input type="hidden" name="id" value="@car.Id" />
                            <button type="submit" class="btn btn-primary w-100">Book Car</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}